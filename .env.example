VITE_BACKEND=server
VITE_SERVER_URL=http://127.0.0.1:4318
VITE_AUTH=dev
IDENTITY=dev
SETTLEMENT=dev
STORE=file
DEV_SETTLE_DELAY_MS=0
DEV_SETTLE_FAIL_RATE=0
DEV_SETTLE_UNKNOWN_RATE=0
DEV_SETTLE_DUPLICATE=0

# NEAR testnet settlement for the public Row. Set SETTLEMENT=near to enable it.
# The operator key is read from NEAR_OPERATOR_KEY, or else from the operator's own file in
# NEAR_CREDENTIALS_DIR (default ~/.near-credentials)/testnet/. Never commit a real key.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_ACCOUNT_ROOT=lantern-caravan.testnet
NEAR_CONTRACT_ID=items.lantern-caravan.testnet
NEAR_OPERATOR_ID=operator.lantern-caravan.testnet
NEAR_PLAYER_SUFFIX=players.lantern-caravan.testnet
NEAR_OPERATOR_KEY=
